# ================================================
# DATABASE ENVIRONMENT VARIABLES (.env.example)
# Copy ini ke .env untuk production use
# ================================================

# MySQL Connection Settings
# -------------------------
DB_HOST=localhost              # MySQL server address
DB_USER=root                   # MySQL username (default: root)
DB_PASSWORD=                   # MySQL password (default: empty for XAMPP)
DB_NAME=kos_sickness_db        # Database name
DB_PORT=3306                   # MySQL port (default: 3306)

# Connection Pool Settings
# -------------------------
DB_CONNECTION_LIMIT=10         # Max concurrent connections
DB_QUEUE_LIMIT=0               # Queue limit for connections waiting
DB_WAIT_FOR_CONNECTIONS=true   # Wait if no connection available

# Database Settings
# -------------------------
DB_CHARSET=utf8mb4             # Character set (support emoji)
DB_TIMEZONE=+07:00             # Timezone (Indonesia)
DB_COLLATION=utf8mb4_unicode_ci # Collation

# Example untuk Production Server
# ================================
# DB_HOST=db.example.com
# DB_USER=prod_user
# DB_PASSWORD=strong_password_here
# DB_NAME=kos_sickness_production
# DB_PORT=3306
# DB_TIMEZONE=+07:00

# ================================================
# TIPS PENGGUNAAN:
# 
# 1. Copy file ini jadi .env
# 2. Update values sesuai konfigurasi Anda
# 3. JANGAN commit .env ke git (sudah di .gitignore)
# 4. Pastikan file hanya readable oleh app process
#
# DEFAULT SETTINGS (Local XAMPP):
# - Host: localhost
# - User: root
# - Password: (kosong)
# - Database: kos_sickness_db
# 
# ================================================
