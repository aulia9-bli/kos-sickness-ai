# ============================================
# Kos-Sickness API - Environment Configuration
# ============================================

# REQUIRED: Groq API Configuration
# Get API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: CORS Configuration
# For development: http://localhost:3000 or auto
# For production: https://your-domain.vercel.app
CORS_ORIGIN=auto

# Node Environment (automatically set by Vercel)
NODE_ENV=production

# ============================================
# FRONTEND CONFIGURATION (Used by Vite)
# ============================================

# API endpoint untuk frontend
# Development: http://localhost:3000/api
# Production: akan di-infer dari Vercel deployment URL
VITE_API_URL=http://localhost:3000/api

# ============================================
# OPTIONAL: Monitoring & Analytics
# ============================================

# Sentry error tracking (optional)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxxx

# Analytics (optional)
# VITE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# Notes for Vercel Deployment
# ============================================
# 1. Set GROQ_API_KEY di Vercel Settings → Environment Variables
# 2. CORS_ORIGIN akan automatically set berdasarkan deployment environment
# 3. NODE_ENV di-set otomatis oleh Vercel (production)
# 4. Frontend akan build dengan nilai default VITE_* variables
